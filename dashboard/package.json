{
  "name": "spanscope",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "Spanscope: self-hosted LLM observability dashboard with OpenTelemetry GenAI span ingest, live web app and JSON API.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "serve": "tsx src/index.ts --serve",
    "dev": "tsx watch src/index.ts --serve",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2"
  }
}
